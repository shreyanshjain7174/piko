{
  "swift.autoGenerateLaunchConfigurations": false,
  "swift.disableAutoResolve": false,
  "files.exclude": {
    "**/.build": true,
    "**/App/Piko.xcodeproj": true,
    "**/DerivedData": true
  },
  "search.exclude": {
    "**/.build": true,
    "**/DerivedData": true
  },
  "[swift]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "sarif-viewer.connectToGithubCodeScanning": "off"
}
